<group name="authentication_failed,brute_force,">
  <rule id="100100" level="10" frequency="10" timeframe="300">
    <if_matched_group>authentication_failed</if_matched_group>
    <same_user />
    <description>Brute-force attack detected: 10 failed login attempts against the same account within 5 minutes.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,brute_force,</group>
  </rule>
</group>
